<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ThunderbirdRecoverySuite</AssemblyName>
    <RootNamespace>ThunderbirdMboxRecovery</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <Authors>WWSoftware's Sistemas</Authors>
    <Company>WWSoftware's Sistemas</Company>
    <Product>Thunderbird Recovery Suite</Product>
    <Description>Suíte portátil para diagnosticar, explorar, reparar, extrair, indexar, fazer backup e restaurar dados do Mozilla Thunderbird.</Description>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.1" />
  </ItemGroup>

</Project>
