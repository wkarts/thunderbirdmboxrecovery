<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ThunderbirdMboxRecovery</AssemblyName>
    <RootNamespace>ThunderbirdMboxRecovery</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <Authors>WWSoftware's Sistemas</Authors>
    <Company>WWSoftware's Sistemas</Company>
    <Product>Thunderbird MBOX Recovery</Product>
    <Description>Recuperação segura de caixas MBOX grandes do Mozilla Thunderbird.</Description>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.1" />
  </ItemGroup>
</Project>
